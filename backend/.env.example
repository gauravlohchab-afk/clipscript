# --- Server ---
PORT=5000
NODE_ENV=development
# Origin allowed by CORS (the Vite dev server by default)
CLIENT_URL=http://localhost:5173
# Public base URL of this API (used for development media links)
PUBLIC_BASE_URL=http://localhost:5000

# --- Database ---
# Leave empty in development to use an in-memory MongoDB (data is lost on restart).
# Required in production.
MONGODB_URI=

# --- AI (Gemini) ---
# Leave empty in development to use the mock AI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Providers ---
# auto | gemini | mock  (auto = gemini when GEMINI_API_KEY is set, otherwise mock outside production)
AI_PROVIDER=auto
# auto | ytdlp | instagram | mock
#   auto      = mock in development, ytdlp in production
#   ytdlp     = real public Instagram Reels via yt-dlp (needs yt-dlp + FFmpeg installed)
#   instagram = legacy oEmbed / Open Graph metadata provider
#   mock      = generated sample Reels, no network
MEDIA_PROVIDER=auto
# Optional Meta app token ("APP_ID|CLIENT_TOKEN") for the official Instagram oEmbed endpoint
META_OEMBED_TOKEN=

# --- yt-dlp ---
# Executable name or full path (default: yt-dlp on PATH)
YTDLP_PATH=
# Process timeouts in milliseconds (metadata extraction / downloads incl. FFmpeg merge)
YTDLP_METADATA_TIMEOUT_MS=60000
YTDLP_DOWNLOAD_TIMEOUT_MS=240000
# Maximum simultaneous yt-dlp processes (a short queue absorbs bursts; beyond that requests get a "busy" error)
YTDLP_MAX_CONCURRENT=2

# --- FFmpeg ---
# Optional explicit binaries; leave empty to use ffmpeg/ffprobe from PATH. FFMPEG_PATH is also passed to yt-dlp.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Limits ---
# Largest video ClipScript will process for analysis/download, in megabytes
MAX_MEDIA_MB=100
